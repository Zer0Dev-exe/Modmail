# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# ID del servidor donde se crean los tickets
GUILD_ID=
# Cadena de conexión de MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/modmail

# Tipos de comandos activados (true/false). Si no se ponen, los dos están activados.
# SLASH=false borra los comandos slash del servidor al arrancar.
SLASH=true
PREFIX=true
